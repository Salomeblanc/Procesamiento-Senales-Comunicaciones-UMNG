clc;
clear;
close all;

% Leer el archivo CSV (debe estar en la misma carpeta que este script)
datos = readmatrix('csv fft primera señal.csv');

% Extraer las columnas D y E
frecuencia = datos(:,4);
potencia (dB) = datos(:,5);

% Graficar la señal
figure;
plot(, frecuencia, 'LineWidth', 1.5);
grid on;

xlabel('Tiempo (s)');
ylabel('Voltaje (V)');
title('Señal en el dominio de frecuencia');